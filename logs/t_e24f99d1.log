+
+if [ "$CONFIRM" != "si" ]; then
+    echo "Cancelado."
+    exit 0
+fi
+
+echo "[INFO] Deteniendo servicios y eliminando volúmenes..."
+docker compose down -v
+
+echo "[OK] Reset completo. Los datos fueron eliminados."
+echo "Para empezar de nuevo: ./start.sh"
