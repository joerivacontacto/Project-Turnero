+        print(f"  RESULTADO: ERROR 422 — Backend rechaza null en peluquero_id")
+        results.append(("Bug 2: peluquero_id=null", "CONFIRMADO", f"HTTP 422"))
+    else:
+        print(f"  RESULTADO: Status {status} (inesperado)")
+        results.append(("Bug 2: peluquero_id=null", "INESPERADO", f"HTTP {status}"))
