+#!/usr/bin/env python3
+"""Test frontend bugs against backend (simulating exactly what the broken frontend does)."""
+import urllib.request
+import urllib.error
+import json
+import sys
+
+BASE = "http://localhost:8080"
+
+def req(method, path, data=None, token=None):
+    url = BASE + path
+    headers = {"Content-Type": "application/json"}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    body = json.dumps(data).encode() if data else None
+    r = urllib.request.Request(url, data=body, headers=headers, method=method)
+    try:
+        with urllib.request.urlopen(r) as resp:
+            raw = resp.read()
+            if resp.status == 204 or not raw:
+                return resp.status, {}
+            return resp.status, json.loads(raw)
+    except urllib.error.HTTPError as e:
+        return e.code, json.loads(e.read())
+
+def main():
+    # Login
+    status, data = req("POST", "/auth/login", {"username": "admin", "password": "admin123"})
+    assert status == 200, f"Login failed: {data}"
+    token = data["access_token"]
+    
+    results = []
+    
+    # === BUG 1: crearTurno() sin hora_fin ===
+    # Frontend sends: cliente_id, servicio_id, peluquero_id, fecha, hora_inicio (SIN hora_fin)
+    print("=" * 60)
+    print("BUG 1: crearTurno() sin hora_fin")
+    print("El frontend envía solo hora_inicio, backend espera hora_fin (NOT NULL)")
+    broken_turno = {
+        "cliente_id": 1,
+        "servicio_id": 1,
+        "peluquero_id": 1,
+        "fecha": "2026-09-02",
+        "hora_inicio": "10:00"
+        # FALTA hora_fin
+    }
+    status, data = req("POST", "/turnos", broken_turno, token=token)
+    print(f"  Status: {status}")
+    print(f"  Response: {data}")
+    if status == 422:
+        print(f"  RESULTADO: ERROR 422 — Backend rechaza porque falta hora_fin")
+        results.append(("Bug 1: crearTurno sin hora_fin", "CONFIRMADO", f"HTTP 422 — {data.get('detail', '')}"))
+    else:
+        print(f"  RESULTADO: Status {status} (inesperado)")
+        results.append(("Bug 1: crearTurno sin hora_fin", "INESPERADO", f"HTTP {status}"))
+    
+    # === BUG 2: peluquero_id=null cuando selecciona "cualquiera" ===
+    print("\n" + "=" * 60)
+    print("BUG 2: peluquero_id=null (frontend envía null, backend espera int)")
+    broken_turno2 = {
+        "cliente_id": 1,
+        "servicio_id": 1,
+        "peluquero_id": None,
+        "fecha": "2026-09-02",
+        "hora_inicio": "10:00",
+        "hora_fin": "10:30"
+    }
+    status, data = req("POST", "/turnos", broken_turno2, token=token)
+    print(f"  Status: {status}")
+    print(f"  Response: {data}")
