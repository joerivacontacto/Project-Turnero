+#!/usr/bin/env python3
+"""Test script for the barbershop booking system API."""
+import urllib.request
+import urllib.error
+import json
+import sys
+
+BASE = "http://localhost:8080"
+
+def req(method, path, data=None, token=None):
+    url = BASE + path
+    headers = {"Content-Type": "application/json"}
+    if token:
+        headers["Authorization"] = f"Bearer {token}"
+    body = json.dumps(data).encode() if data else None
+    r = urllib.request.Request(url, data=body, headers=headers, method=method)
+    try:
+        with urllib.request.urlopen(r) as resp:
+            return resp.status, json.loads(resp.read())
+    except urllib.error.HTTPError as e:
+        return e.code, json.loads(e.read())
+
+def main():
+    results = []
+    
+    # 1. Login
+    print("=" * 60)
+    print("TEST 1: Login")
+    status, data = req("POST", "/auth/login", {"username": "admin", "password": "admin123"})
+    print(f"  Status: {status}")
+    if status == 200:
+        token = data["access_token"]
+        rol = data["rol"]
+        print(f"  Rol: {rol}")
+        print(f"  Token: {token[:40]}...")
+        results.append(("Login", "PASS", f"rol={rol}"))
+    else:
+        print(f"  ERROR: {data}")
+        results.append(("Login", "FAIL", str(data)))
+        return results
+
+    # 2. List services
+    print("\n" + "=" * 60)
+    print("TEST 2: Listar servicios")
+    status, data = req("GET", "/servicios", token=token)
+    print(f"  Status: {status}")
+    if status == 200:
+        for s in data:
+            print(f"  - {s['nombre']} ({s['duracion_min']}min, ${s['precio']})")
+        results.append(("Listar servicios", "PASS", f"{len(data)} servicios"))
+    else:
+        print(f"  ERROR: {data}")
+        results.append(("Listar servicios", "FAIL", str(data)))
+
+    # 3. List barbers
+    print("\n" + "=" * 60)
+    print("TEST 3: Listar peluqueros")
+    status, data = req("GET", "/peluqueros", token=token)
+    print(f"  Status: {status}")
+    if status == 200:
+        for p in data:
