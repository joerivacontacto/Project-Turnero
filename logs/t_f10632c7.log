+#!/usr/bin/env python3
+"""Test full end-to-end flow: frontend serving + backend API."""
+import urllib.request
+import urllib.error
+import json
+
+FRONTEND = "http://localhost:3000"
+BACKEND = "http://localhost:8080"
+
+def fetch(url):
+    r = urllib.request.Request(url)
+    with urllib.request.urlopen(r) as resp:
+        return resp.status, resp.read().decode()
+
+def main():
+    print("=" * 60)
+    print("TEST: Frontend sirviendo correctamente")
+    status, html = fetch(FRONTEND + "/")
+    print(f"  Status: {status}")
+    print(f"  Tamaño HTML: {len(html)} bytes")
+    print(f"  Contiene 'TurnosPro': {'TurnosPro' in html}")
+    
+    print("\n" + "=" * 60)
+    print("TEST: Frontend carga api.js")
+    status, js = fetch(FRONTEND + "/js/api.js")
+    print(f"  Status: {status}")
+    print(f"  Tamaño: {len(js)} bytes")
+    print(f"  API_BASE: {'http://localhost:8080' in js}")
+    
+    print("\n" + "=" * 60)
+    print("TEST: Frontend carga app.js")
+    status, js = fetch(FRONTEND + "/js/app.js")
+    print(f"  Status: {status}")
+    print(f"  Tamaño: {len(js)} bytes")
+    
+    print("\n" + "=" * 60)
+    print("TEST: Frontend carga index.html con scripts referenciados")
+    print(f"  api.js referenciado: {'js/api.js' in html}")
+    print(f"  app.js referenciado: {'js/app.js' in html}")
+
+if __name__ == "__main__":
+    main()
