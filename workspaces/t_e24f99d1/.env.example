# ============================================================
# Calendario de Turnos — Variables de Entorno
# ============================================================
# Copiar este archivo a .env y ajustar los valores.
# El script start.sh lo hace automáticamente.

# --- JWT ---
# ⚠️  CAMBIAR EN PRODUCCIÓN — usar clave de 32+ caracteres
JWT_SECRET_KEY=cambiar-esto-por-una-clave-segura-de-al-menos-32-caracteres

# --- Zona horaria ---
TZ=America/Argentina/Buenos_Aires

# --- Puerto de la aplicación (host) ---
APP_PORT=8080

# --- Nivel de log (debug, info, warning, error) ---
LOG_LEVEL=info

# --- Backup automático (hora militar, 0-23) ---
BACKUP_HOUR=3
BACKUP_MINUTE=0

# --- Intervalo de verificación de recordatorios (segundos) ---
RECORDATORIO_INTERVAL=60
